\begin{tikzpicture}
	\draw
		(0,0) node[op amp, noinv input up](OA) {}
		(OA.+)  -- ++ (-0.5,0)
		node[ocirc] {} node[left] {$V_\mathrm{in}$}
		(OA.out) to[short, -o] ++ (0.5,0)
		node[right] {$V_\mathrm{out}$}

		% feedback resistors
		(OA.out) to[R, l=$R_1$, *-*] ++ (0,-2) coordinate (Center)
		to[R, l=$R_2$] ++ (0,-2)
		node[rground] {}

		(Center) -| ($(OA.-)+(-0.5,0)$)
		-- (OA.-)
	;
\end{tikzpicture}

