\begin{tikzpicture}
	\draw
		% draw an attenuator with specified values that divides +-12V to +-3V
		(0,0) node[ground] {}
		to[resistor, l=$R_2$, -*] ++ (0,2) coordinate (Center)
		to[resistor, l=$R_1$] ++ (0,2)
		node[vcc] {$V_{cc}$}

		(Center) to[short, -*] ++ (1,0) coordinate (Center)
		to[resistor, l=$R_L$] ++ (0,-2)
		node[ground] {}

		(Center) to[short, -o] ++ (1,0) node[auto, anchor=west] {$U_{out}$}
	;
\end{tikzpicture}

