\begin{tikzpicture}
	\draw
		(0,0) node[op amp](OA) {}
		(OA.+) -| ++ (-0.5,-0.5)
		node[rground] {}

		(OA.out) to[short, -o] ++ (0.5,0)
		node[right] {$V_\mathrm{out}$}

		% feedback resistors
		(OA.-) |- ++ (0,1) coordinate(Top)
		to[resistor, l=$R_f$] (Top-|OA.out)
		to[short, -*] (OA.out)

		(OA.-) -- ++ (-1.5,0) coordinate (NegIn)
		to[resistor, l=$R_1$, -o] ++ (-2,0)
		node[left] {$V_1$}
		(NegIn) -- ++ (0,-1)
		to[resistor, l=$R_2$, -o] ++ (-2,0)
		node[left] {$V_2$}
	;
\end{tikzpicture}

