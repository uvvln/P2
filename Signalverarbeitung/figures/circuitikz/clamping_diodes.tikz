\begin{tikzpicture}
	\draw
		(0,0) node[op amp, noinv input up](OA) {}
		(OA.+)  -- ++ (-0.5,0)
		node[ocirc] {} node[left] {$V_\mathrm{in}$}

		% feedback resistors
		(OA.out) node[circ] {}
		to[R, l=$R_1$, -*] ++ (0,-2) coordinate (Center)
		to[R, l=$R_2$] ++ (0,-2)
		node[rground] {}

		(Center) -| ($(OA.-)+(-0.5,0)$)
		-- (OA.-)

		(OA.out) -- ++ (0.5,0)
		to[R, l=$\SI{1}{\kilo\ohm}$] ++ (2,0)
		to[short, -*] ++ (0.5,0) coordinate (Clamp)
		to[short, -o] ++ (1,0) node[right] {$V_\mathrm{out}$}

		(Clamp) ++ (0,-2) node[vee] {$\SI{-5}{\volt}$}
		to[diode] (Clamp)
		to[diode] ++ (0,2)
		node[vcc] {$\SI{5}{\volt}$}
	;
\end{tikzpicture}

