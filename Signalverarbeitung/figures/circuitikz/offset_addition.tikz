\begin{tikzpicture}
	\draw
		(0,0) node[ground] {}
		to[european voltage source, l=$U_{+}$] ++ (0,2)
		to[resistor, l=$R_2$, -*] ++ (0,2) coordinate (Center)
		to[resistor, l=$R_1$] ++ (0,2)
		node[vcc] {$U_{in}$}
		(Center) to[short, -o] ++ (1,0) node[auto, anchor=west] {$U_{out}$}

		(0,-1) node[below] {(a)}
	;
	\tikzset{shift={(5,0)}} % move coordinate origin to the right
	\draw
		(0,0) node[ground] (gnd) {}
		to[european voltage source, l=$\SI{1,8}{\volt}$] ++ (0,2) coordinate (Voffset)
		to[resistor, l2=$R_2$ and $\SI{2,26}{\kilo\ohm}$, -*] ++ (0,2) coordinate (Center)
		to[resistor, l2=$R_1$ and $\SI{11,5}{\kilo\ohm}$] ++ (0,2)
		node[vcc] (vcc) {$\SI{\pm9}{\volt}$}
		(Center) to[short, -*] ++ (1,0) coordinate (Center) 
		to[capacitor, l2=$C_2$ and $\SI{470}{\pico\farad}$] ++ (0,-2)
		to[short, -*] (Voffset)
		(vcc) to[short, *-] ++ (1,0) coordinate (Top)
		to[capacitor, l2=$C_1$ and $\SI{82}{\pico\farad}$] (Center)
		(Top) to[short, *-] ++ (2,0) coordinate (Top)
		to[vC, l2=$C_T$ and $\SI{\approx 15}{\pico\farad}$, -] ++ (0,-2) coordinate (Middle)
		to[short, *-] (Center)
		(Middle) to[short, -o] ++ (1,0)
		node[auto, anchor=west] {$\SI{0}{\volt} \to \SI{3}{\volt}$}

		(0,-1) node[below] {(b)}
	;
\end{tikzpicture}

